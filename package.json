{
  "name": "autocast",
  "version": "0.1.0",
  "description": "Agent-driven demo video recorder for web and non-web projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShivaPriyanShanmuga/autocast.git"
  },
  "keywords": [
    "demo",
    "video",
    "screencast",
    "recorder",
    "agent",
    "terminal",
    "playwright",
    "ffmpeg"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "autocast": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "AGENTS.md",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/fix-spawn-helper.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@napi-rs/canvas": "^1.0.8",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.62.1",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
